{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "AUC-ROC Over Time",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "model_auc_roc{model_name=~\"$model\"}",
          "legendFormat": "{{ model_name }} ({{ model_version }})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "AUC-ROC",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.90 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Model Inference Latency",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(model_inference_duration_seconds_bucket{model_name=~\"$model\"}[5m])) by (le, model_name))",
          "legendFormat": "{{ model_name }} p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(model_inference_duration_seconds_bucket{model_name=~\"$model\"}[5m])) by (le, model_name))",
          "legendFormat": "{{ model_name }} p50",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Latency",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "A/B Model Comparison",
      "type": "barchart",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "model_auc_roc",
          "legendFormat": "AUC-ROC: {{ model_name }}",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "model_precision",
          "legendFormat": "Precision: {{ model_name }}",
          "refId": "B",
          "instant": true
        },
        {
          "expr": "model_recall",
          "legendFormat": "Recall: {{ model_name }}",
          "refId": "C",
          "instant": true
        },
        {
          "expr": "model_f1_score",
          "legendFormat": "F1: {{ model_name }}",
          "refId": "D",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 80
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "groupWidth": 0.7,
        "barWidth": 0.9
      }
    },
    {
      "title": "Feature Drift Detection",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "feature_drift_score{feature=~\"$feature\"}",
          "legendFormat": "{{ feature }}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "PSI (Population Stability Index)",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fraud-detection", "model-performance"],
  "templating": {
    "list": [
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(model_auc_roc, model_name)",
        "includeAll": true,
        "multi": true,
        "name": "model",
        "query": "label_values(model_auc_roc, model_name)",
        "type": "query"
      },
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(feature_drift_score, feature)",
        "includeAll": true,
        "multi": true,
        "name": "feature",
        "query": "label_values(feature_drift_score, feature)",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Fraud Detection - Model Performance",
  "uid": "model-performance",
  "version": 1
}
